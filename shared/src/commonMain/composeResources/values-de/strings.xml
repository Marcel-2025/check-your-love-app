    <string name="friend_title_0">Noch ganz am Anfang</string>
    <string name="friend_title_1">Ausbaufähig</string>
    <string name="friend_title_2">Gute Kumpel</string>
    <string name="friend_title_3">Echte Freunde</string>
    <string name="friend_title_4">Beste Freunde</string>
    <string name="friend_title_5">Seelen-Freunde</string>
    <string name="friend_text_0_0">Jede große Freundschaft fängt mal klein an. Zeit für ein gemeinsames Abenteuer!</string>
    <string name="friend_text_0_1">Die Chemie braucht noch etwas Anlauf – ein gemeinsamer Lachanfall wirkt Wunder.</string>
    <string name="friend_text_0_2">Vielleicht kennt ihr euch einfach noch nicht gut genug. Das lässt sich ändern!</string>
    <string name="friend_text_1_0">Da ist was – aber ihr habt noch viel voneinander zu entdecken.</string>
    <string name="friend_text_1_1">Ein paar gemeinsame Insider-Witze, und das wird richtig gut.</string>
    <string name="friend_text_1_2">Mehr Zeit zusammen, weniger Zeit am Handy – dann klappt das.</string>
    <string name="friend_text_2_0">Ihr seid ein solides Team. Mit euch wird es selten langweilig.</string>
    <string name="friend_text_2_1">Gute Gespräche, gute Laune – auf euch kann man zählen.</string>
    <string name="friend_text_2_2">Ihr habt eine entspannte Freundschaft mit viel Potenzial nach oben.</string>
    <string name="friend_text_3_0">Ihr versteht euch oft ohne Worte. Das ist echte Freundschaft.</string>
    <string name="friend_text_3_1">Mit euch beiden wird jeder Abend zur Geschichte, die man später erzählt.</string>
    <string name="friend_text_3_2">Ihr seid füreinander da – auch wenn es mal schwierig wird.</string>
    <string name="friend_text_4_0">Beste Freunde durch und durch. Ihr teilt Lachen, Geheimnisse und Snacks.</string>
    <string name="friend_text_4_1">Wo einer ist, ist der andere nicht weit. Ein unschlagbares Duo!</string>
    <string name="friend_text_4_2">Ihr kennt die Lieblingslieder, Macken und Träume des anderen.</string>
    <string name="friend_text_5_0">Seelenverwandte Freunde! So eine Verbindung findet man selten.</string>
    <string name="friend_text_5_1">Ihr seid wie zwei Hälften eines sehr witzigen Ganzen.</string>
    <string name="friend_text_5_2">Diese Freundschaft hält ein Leben lang – mindestens.</string>
