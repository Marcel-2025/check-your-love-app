    <string name="test_headline_friend">Wie stark ist eure Freundschaft?</string>
    <string name="test_subtitle_friend">Gib zwei Namen ein – das Herz verrät, wie gut ihr befreundet seid.</string>
    <string name="field_name_b_friend">Name deines Lieblingsmenschen</string>
