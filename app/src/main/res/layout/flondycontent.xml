<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mywhite" >

    <View
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/flondy3d" />

    <View
        android:id="@+id/facebookbtn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/header"
        android:layout_marginLeft="30dp"
        android:background="@drawable/fb_selector"
        android:onClick="GotoFB" />

    <View
        android:id="@+id/twitterbtn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentRight="true"
        android:layout_below="@id/header"
        android:layout_marginRight="30dp"
        android:background="@drawable/tw_selector"
        android:onClick="GotoTW" />

    <TextView
        android:id="@+id/Hgreen1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/facebookbtn"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="#00FF00"
        android:gravity="center_horizontal"
        android:text="Du magst unsere App ?"
        android:textColor="@color/myblack"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/Abschnitt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Hgreen1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal|clip_horizontal"
        android:text="Dann bewerte sie doch bitte positiv in Google Play :)"
        android:textColor="@color/myblack" />

    <TextView
        android:id="@+id/Hgreen2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Abschnitt1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="#00FF00"
        android:gravity="center_horizontal"
        android:text="Mehr apps/games von uns ?"
        android:textColor="@color/myblack"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/Abschnitt2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Hgreen2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:text="oder besuche unsere eigene Webseite :"
        android:textColor="@color/myblack" />

    <Button
        android:id="@+id/gotoflondybutton"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_below="@id/Abschnitt2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:onClick="GotoFD"
        android:text="http://flondy.com"
        android:textColor="@color/myURLblue"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/Abschnitt3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/gotoflondybutton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:text="Dort gibt es zudem mehr Infos über Flondy und ihr könnt uns unter dem &quot;donate&quot; tab eine Kleinigkeit spenden ..."
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/myblack" />

    <Button
        android:id="@+id/gotodonatebutton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@id/Abschnitt3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/donateicon"
        android:gravity="center_horizontal"
        android:onClick="GotoDonateUs" />

    <TextView
        android:id="@+id/Abschnitt4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/gotodonatebutton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:text="Damit wir weiterhin tolle Apps"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/myblack" />

    <TextView
        android:id="@+id/Hgreen3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Abschnitt4"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="#00FF00"
        android:gravity="center_horizontal"
        android:text="Ihr wollt uns kontaktieren ?"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@color/myblack"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/Abschnitt5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Hgreen3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:text="Fragen um Flondy und Support und zu allen Apps (auch bugmeldungen) bitte ausschließlich an :"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/myblack" />

    <Button
        android:id="@+id/gotoemailusbtn1"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_below="@id/Abschnitt5"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:onClick="EmailUsGmail"
        android:text="flondy.dev@gmail.com"
        android:textColor="@color/myURLblue" />

    <TextView
        android:id="@+id/Abschnitt6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/gotoemailusbtn1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:text="Anfragen wie Verbesserungsvorschläge und co. und Anfragen zu komerziellen Dienstleistungen oder sonstigen Dingen bitte direkt an :"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/myblack" />

    <Button
        android:id="@+id/gotoemailusbtn2"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_below="@id/Abschnitt6"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:onClick="GotoEmailUsFlondymail"
        android:text="contact@flondy.com"
        android:textColor="@color/myURLblue" />

    <TextView
        android:id="@+id/Abschnitt7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/gotoemailusbtn2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:gravity="center_horizontal"
        android:text="↓ ↓ ↓ ↓ ↓     Besuche uns     ↓ ↓ ↓ ↓ ↓"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/myblack" />

    <View
        android:id="@+id/playstorebtn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/Abschnitt7"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/playstoreicon_selector"
        android:onClick="GotoPlayStore" />

    <TextView
        android:id="@+id/Playstoresignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/playstorebtn"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:text="In Google´s Playstore"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/myblack" />

    <View
        android:id="@+id/appstorebtn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentRight="true"
        android:layout_below="@id/Abschnitt7"
        android:layout_marginRight="25dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/appstoreicon_selector"
        android:onClick="GotoAppStore" />

    <TextView
        android:id="@+id/Appstoresignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@id/appstorebtn"
        android:layout_marginRight="5dp"
        android:layout_marginTop="10dp"
        android:text="In Apple´s Appstore"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/myblack" />

    <View
        android:id="@+id/flondystorebtn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/Playstoresignature"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:background="@drawable/flondystoreicon_selector"
        android:onClick="GotoFlondyStore" />

    <TextView
        android:id="@+id/Flondystoresignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/flondystorebtn"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:text="Oder in unserem eigenen Store"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/myblack" />

</RelativeLayout>