    <!-- Result titles per range -->
    <string name="result_title_0">Best friends material</string>
    <string name="result_title_1">Room to grow</string>
    <string name="result_title_2">Something is there</string>
    <string name="result_title_3">Strong connection</string>
    <string name="result_title_4">Heart flutters</string>
    <string name="result_title_5">Soulmates</string>

    <!-- Result texts: 0–19 -->
    <string name="result_text_0_0">The stars are a little shy today. Maybe it becomes a wonderful friendship – those often last the longest.</string>
    <string name="result_text_0_1">A small number – but real feelings can\'t be measured in percent anyway.</string>
    <string name="result_text_0_2">The love test just shrugs. Luckily, you two decide – not an app.</string>
    <!-- 20–39 -->
    <string name="result_text_1_0">A gentle spark. Add some humour and a few pizza nights and who knows?</string>
    <string name="result_text_1_1">Plenty of room for surprises – and surprises are fun.</string>
    <string name="result_text_1_2">Opposites attract, they say. Why not find out?</string>
    <!-- 40–59 -->
    <string name="result_text_2_0">Right in the middle: the perfect mix of common ground and things to talk about.</string>
    <string name="result_text_2_1">There\'s definitely something here. Now someone just has to make the first move.</string>
    <string name="result_text_2_2">Half full, not half empty – lots of potential here.</string>
    <!-- 60–79 -->
    <string name="result_text_3_0">Sparks are flying! You go together like coffee and croissants.</string>
    <string name="result_text_3_1">A strong connection – this looks like long talks late into the night.</string>
    <string name="result_text_3_2">Lovely numbers! A smile is pretty much guaranteed.</string>
    <!-- 80–94 -->
    <string name="result_text_4_0">Heart flutters guaranteed! You two make a pretty great team.</string>
    <string name="result_text_4_1">Wow – the chemistry between you is right.</string>
    <string name="result_text_4_2">So much harmony, even the stars are getting jealous.</string>
    <!-- 95–100 -->
    <string name="result_text_5_0">Soulmates! If there were a soundtrack, it would start playing now.</string>
    <string name="result_text_5_1">Almost perfect – you two seem made for each other.</string>
    <string name="result_text_5_2">Bullseye! Cupid clearly had a very good aim today.</string>

